{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["koim"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "koim — IM Overview",
  "uid": "koim-overview",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Active WS sessions",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "sum(koim_ws_sessions_active{job=\"koim\"})", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "type": "stat",
      "title": "Offline queue size",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "sum(koim_offline_queue_size{job=\"koim\"})", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "type": "stat",
      "title": "Send rate (1m)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "sum(rate(koim_message_sent_total[1m]))", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "type": "stat",
      "title": "Send failure %",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "100 * sum(rate(koim_message_sent_total{result=\"fail\"}[5m])) / clamp_min(sum(rate(koim_message_sent_total[5m])), 1e-9)",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "type": "timeseries",
      "title": "WebSocket connect / disconnect rate",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(koim_ws_connect_total[1m]))", "refId": "A", "legendFormat": "connect" },
        { "expr": "sum(rate(koim_ws_disconnect_total[1m]))", "refId": "B", "legendFormat": "disconnect" }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Message throughput by peerType",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (peerType) (rate(koim_message_sent_total[1m]))",
          "refId": "A",
          "legendFormat": "{{peerType}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "type": "timeseries",
      "title": "Message delivery latency (p50/p95/p99)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(koim_message_delivery_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(koim_message_delivery_seconds_bucket[5m])))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(koim_message_delivery_seconds_bucket[5m])))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "type": "timeseries",
      "title": "Redis fanout pub/sub",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(koim_redis_fanout_published_total[1m]))", "refId": "A", "legendFormat": "published" },
        { "expr": "sum(rate(koim_redis_fanout_received_total[1m]))", "refId": "B", "legendFormat": "received" }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" }
    },
    {
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"koim\",area=\"heap\"})",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency by URI",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"koim\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{uri}}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
